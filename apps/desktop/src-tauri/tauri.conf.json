{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audora",
  "version": "1.1.2",
  "identifier": "com.audora.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/desktop/ui dev",
    "beforeBuildCommand": "pnpm --dir apps/desktop/ui build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Audora",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob:; media-src 'self' asset: https://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "appimage"],
    "resources": [
      "../../../THIRD_PARTY_NOTICES.md",
      "../../../sbom.cdx.json"
    ],
    "icon": [
      "../../../assets/icons/32x32.png",
      "../../../assets/icons/icon.png",
      "../../../assets/icons/icon.ico"
    ],
    "licenseFile": "../../../LICENSE",
    "copyright": "Copyright (c) 2026 Audora Contributors",
    "category": "Video",
    "shortDescription": "Local-first desktop audio & video player with timestamped notes",
    "longDescription": "Cross-platform desktop audio and video player built with Rust (tao + wry) that pairs clean playback with effortless timestamped notes.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "files": {
        "Resources/uninstall-cleanup.sh": "./installer/macos/uninstall-cleanup.sh"
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerHooks": "./installer/windows/nsis-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "postRemoveScript": "./installer/linux/postrm",
        "files": {
          "/usr/share/audora/postrm": "./installer/linux/postrm"
        }
      }
    }
  }
}
