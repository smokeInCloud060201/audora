{
  "name": "audora-workspace",
  "version": "1.1.3",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:ui": "pnpm --dir apps/desktop/ui dev",
    "build:ui": "pnpm --dir apps/desktop/ui build",
    "typecheck": "pnpm --dir apps/desktop/ui typecheck",
    "test:ui": "pnpm --dir apps/desktop/ui test",
    "fmt:rust": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace",
    "check": "pnpm typecheck && pnpm test:ui && pnpm fmt:check && pnpm lint:rust && pnpm test:rust",
    "verify:release": "node scripts/verify-release.mjs"
  }
}
